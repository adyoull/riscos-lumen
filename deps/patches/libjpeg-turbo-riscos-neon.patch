+    r.r[0] = 0;
+    if (_kernel_swi(0x58EC8, &r, &r) == NULL &&
+        (r.r[1] & 0xF) == 2 && ((r.r[2] >> 8) & 0xF) != 0)
+      simd_support |= JSIMD_NEON;
+  }
